# ---------------------------------------------------------------------------
# Template for .env.submit - copy it and fill in the blanks:
#
#   cp .env.submit.example .env.submit
#
# Deploy credentials for `npm run deploy` (read automatically by `wxt submit` /
# publish-browser-extension, and by deploy.js). The real .env.submit is
# gitignored - never commit it.
#
# Verify your setup with:  npm run deploy:check
# Full walkthrough:        see the "Deploying" section of README.md
# ---------------------------------------------------------------------------

# ============================ Chrome Web Store =============================
# Setup guide: https://developer.chrome.com/docs/webstore/using-api#setup

# The 32-character ID of your published item. Found on the Chrome Web Store
# developer dashboard (under the extension name) or in the item's URL:
#   https://chromewebstore.google.com/detail/<slug>/<THIS_ID>
CHROME_EXTENSION_ID=""

# Google Cloud Console > APIs & Services > Credentials
#   1. Enable the "Chrome Web Store API" for your project
#   2. Create credentials > OAuth client ID > Application type: "Web application"
#   3. Add this Authorized redirect URI (required by the Playground below):
#        https://developers.google.com/oauthplayground
#   4. Copy the client ID and client secret here
CHROME_CLIENT_ID=""
CHROME_CLIENT_SECRET=""

# Generate with the OAuth 2.0 Playground. NOTE: the tool's built-in
# "Generate new refresh token?" prompt uses Google's retired out-of-band flow
# and fails with redirect_uri_mismatch, so use the playground instead:
#   1. Open https://developers.google.com/oauthplayground
#   2. Gear icon (top right) > check "Use your own OAuth credentials"
#      > paste the client ID and secret from above
#   3. In "Step 1", enter this scope:
#        https://www.googleapis.com/auth/chromewebstore
#   4. "Authorize APIs" > sign in > "Exchange authorization code for tokens"
#   5. Copy the returned refresh_token here
#
# CAUTION: if your OAuth consent screen is still in "Testing" publishing
# status, Google expires this refresh token after 7 days. Move the app to
# "In production" for a token that keeps working.
CHROME_REFRESH_TOKEN=""

# "default" = public release channel, "trustedTesters" = internal channel
CHROME_PUBLISH_TARGET="default"

# false = upload AND submit for review, true = upload only (no review/submit)
CHROME_SKIP_SUBMIT_REVIEW=false

# ============================= Firefox Add-ons =============================
# The add-on ID is public (it is baked into the built manifest), so this is
# pre-filled. deploy.js can derive it too, making this field optional.
FIREFOX_EXTENSION_ID="extension@gofakeit.com"

# Create these at:
#   https://addons.mozilla.org/developers/addon/api/key/
# "Generate new credentials" gives you a JWT issuer (= API key) and a JWT
# secret (= API secret). There is no cost and no review step to get them.
FIREFOX_JWT_ISSUER=""
FIREFOX_JWT_SECRET=""

# "listed" = public on addons.mozilla.org, "unlisted" = self-hosted only
FIREFOX_CHANNEL="listed"
